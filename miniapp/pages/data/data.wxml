<view class="app {{dark ? 'theme-dark' : ''}}">
  <image class="app-bg" src="{{bg}}" mode="aspectFill" />
  <view class="bg-tint"></view>

  <view class="pg d-page">

    <!-- ============ 累计卡（Web TotalCard） ============ -->
    <view class="glass card">
      <view class="ft-xs track-widest op-50 mb3">累计</view>

      <view class="row items-end flex-wrap gap6 mb6">
        <view>
          <view class="num d-num">{{allCount}}</view>
          <view class="ft-xs op-60 mt1">次肯定语</view>
        </view>
        <view>
          <view class="num d-num">{{allMin}}</view>
          <view class="ft-xs op-60 mt1">分钟专注</view>
        </view>
        <view>
          <view class="num d-num">{{breathAllMin}}</view>
          <view class="ft-xs op-60 mt1">分钟 · 呼吸调整</view>
        </view>
      </view>

      <view class="ft-xs op-60 mb2">主题分布</view>
      <view wx:if="{{distRows.length}}" class="d-stack">
        <view class="row d-bar-row" wx:for="{{distRows}}" wx:key="tag">
          <view class="ft-xs d-tag">#{{item.tag}}</view>
          <view class="bar-track">
            <view class="bar-fill" style="width:{{item.pct}}%"></view>
          </view>
          <view class="num ft-xs d-count">{{item.count}}</view>
        </view>
      </view>
      <view wx:else class="ft-xs op-50">还没有数据，去专注一次吧。</view>
    </view>

    <!-- ============ 近 30 天卡（Web MonthCard） ============ -->
    <view class="glass card mt6">
      <view class="row-between mb4">
        <view class="ft-xs track-widest op-50">近 30 天</view>
        <view class="ft-xs op-60 d-sumline">
          <text class="num ft-lg">{{monthCount}}</text>次 ·
          <text class="num ft-lg">{{monthMin}}</text>分钟 ·
          <text class="num ft-lg">{{monthBreathMin}}</text>分钟呼吸
        </view>
      </view>

      <!-- 打卡日历（Web CalendarHeat） -->
      <view class="ft-xs op-60 mb2">打卡日历</view>
      <view class="heat-week">
        <text class="heat-wd" wx:for="{{heatWeek}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="heat-grid">
        <view
          wx:for="{{heat}}"
          wx:key="index"
          class="heat-cell {{item.has ? 'heat-on' : ''}}"
          style="{{item.has ? 'background:' + item.color + '55;border-color:' + item.color : ''}}"
          data-date="{{item.date}}"
          bindtap="openDay"
        >
          <text wx:if="{{!item.pad}}" class="num {{item.has ? 'heat-num on' : 'heat-num'}}">{{item.day}}</text>
        </view>
      </view>
      <view class="heat-legend" wx:if="{{heatLegend.length}}">
        <view class="lg-item" wx:for="{{heatLegend}}" wx:key="tag">
          <view class="lg-dot" style="background:{{item.color}}"></view>
          <text class="ft-10 op-70">#{{item.tag}}</text>
        </view>
      </view>

      <!-- 时间分配饼图（Web PieChart） -->
      <view class="ft-xs op-60 mt6 mb2">时间分配</view>
      <block wx:if="{{showPie}}">
        <view class="row items-start gap4 mt3">
          <canvas type="2d" id="pie" class="pie-canvas"></canvas>
          <view class="flex-1 d-pielegend">
            <view class="pie-row" wx:for="{{pieRows}}" wx:key="tag">
              <view class="pie-dot" style="background:{{item.color}}"></view>
              <view class="pie-tag ft-xs ellipsis">#{{item.tag}}</view>
              <view class="num ft-xs pie-v">{{item.min}}分</view>
              <view class="num ft-xs pie-v">×{{item.count}}</view>
              <view class="num ft-xs pie-v op-50">{{item.pct}}%</view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="ft-xs op-50">还没有数据。</view>
    </view>
  </view>

  <view class="foot">
    <text>本工具仅供日常正念打卡与习惯记录使用，不提供任何专业建议。</text>
    <text>所有数据仅存储于本机，我们不收集、不上传、不分享任何个人信息。</text>
  </view>

  <!-- ============ 单日明细（Web DayDetailModal） ============ -->
  <view class="overlay" wx:if="{{dayVisible}}" bindtap="closeDay">
    <view class="dialog dlg-sm" catchtap="noop">
      <view class="dialog-close" catchtap="closeDay">✕</view>
      <view class="ft-xs op-60 mb1">{{day.date}}</view>
      <view class="serif ft-xl mb4">当日专注</view>

      <view class="row gap3 mb5">
        <view class="glass d-mini">
          <view class="num ft-2xl">{{day.count}}</view>
          <view class="ft-10 op-60 mt1">次肯定语</view>
        </view>
        <view class="glass d-mini">
          <view class="num ft-2xl">{{day.min}}</view>
          <view class="ft-10 op-60 mt1">分钟专注</view>
        </view>
        <view class="glass d-mini">
          <view class="num ft-2xl">{{day.breathMin}}</view>
          <view class="ft-10 op-60 mt1">分钟呼吸</view>
        </view>
      </view>

      <block wx:if="{{day.rows.length}}">
        <view class="ft-xs op-60 mb2">主题分布</view>
        <view>
          <view class="row d-day-row" wx:for="{{day.rows}}" wx:key="tag">
            <view class="pie-dot" style="background:{{item.color}}"></view>
            <view class="flex-1 ft-xs">#{{item.tag}}</view>
            <view class="num ft-xs op-70">{{item.min}}分</view>
            <view class="num ft-xs op-70">×{{item.count}}</view>
          </view>
        </view>
      </block>
      <view wx:else class="ft-xs op-60">当日暂无肯定语专注记录。</view>
    </view>
  </view>
</view>
