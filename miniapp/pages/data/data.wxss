/* 数据中心 */
.bar-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--glass);
  border: 1rpx solid var(--border);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  opacity: .55;
}

.heat-week {
  display: flex;
}
.heat-wd {
  width: calc(100% / 7);
  text-align: center;
  font-size: 18rpx;
  color: var(--mut2);
}
.heat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.heat-cell {
  width: calc(100% / 7);
  padding: 6rpx;
  box-sizing: border-box;
}
.heat-cell > view {
  width: 100%;
  height: 78rpx;
  border-radius: 14rpx;
  background: var(--glass);
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.heat-num {
  font-size: 18rpx;
  color: var(--mut2);
}
.heat-num.on {
  color: var(--fg);
  font-weight: 600;
}

.heat-legend {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 18rpx;
  color: var(--mut);
  margin-right: 18rpx;
}
.heat-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.pie-canvas {
  width: 300rpx;
  height: 300rpx;
  flex: none;
}
.pie-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  padding: 6rpx 0;
}
.pie-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  flex: none;
}
.pie-tag {
  flex: 1;
  min-width: 0;
}
.pie-v {
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}
