<view class="app {{dark ? 'theme-dark' : ''}}">
  <image class="app-bg" src="{{bg}}" mode="aspectFill" />
  <view class="bg-tint"></view>

  <view class="pg shell-main s-grid">

    <!-- ============ 使用说明（Web UsageGuide 卡） ============ -->
    <view class="glass card">
      <view class="s-guide-head" hover-class="pressed" bindtap="guideToggle">
        <view class="row gap2">
          <text class="ft-lg">◈</text>
          <text class="serif ft-xl">使用说明</text>
        </view>
        <text class="ft-xs op-50 s-caret">{{guideOpen ? '⌃' : '⌄'}}</text>
      </view>

      <block wx:if="{{guideOpen}}">
        <view class="s-guide mt5">
          <view wx:for="{{guide}}" wx:key="t" class="g-sec">
            <view class="serif ft-base g-h">{{item.t}}</view>
            <view
              wx:for="{{item.lines}}"
              wx:for-item="ln"
              wx:for-index="li"
              wx:key="li"
              class="g-p ft-sm lh-relaxed"
            >{{ln}}</view>
          </view>
        </view>
      </block>

      <view class="card-sep"></view>
      <view class="sw-row">
        <text class="ft-sm">保留主页快捷入口</text>
        <switch checked="{{homeGuideShortcut}}" color="#4a79b8" data-field="homeGuideShortcut" bindchange="onSwitch" />
      </view>
      <view class="row-between mt4">
        <text class="ft-10 op-55">外观 · 专注 · 呼吸 · 数据</text>
        <text class="ft-10 op-55 s-log" hover-class="pressed" bindtap="openLog">更新日志 ›</text>
      </view>
    </view>

    <!-- ============ 外观 ============ -->
    <view class="glass card">
      <view class="serif ft-xl mb4">外观</view>

      <view class="ft-xs op-60 track-widest mb2">主题模式</view>
      <view class="seg-pair mb5">
        <view class="sseg {{theme === 'light' ? 'sel' : ''}}" data-t="light" hover-class="pressed" bindtap="themeTap">
          <text>◐ 日间</text>
        </view>
        <view class="sseg {{theme === 'dark' ? 'sel' : ''}}" data-t="dark" hover-class="pressed" bindtap="themeTap">
          <text>◑ 夜间</text>
        </view>
      </view>

      <view class="ft-xs op-60 track-widest mb2">背景图片</view>
      <view class="row gap2 mb3">
        <view class="act flex-1" hover-class="pressed" bindtap="pickBg">上传背景图</view>
        <view class="act flex-1" hover-class="pressed" bindtap="resetBg">恢复默认海浪背景</view>
      </view>
      <view class="ft-10 op-55" wx:if="{{customBg}}">当前已使用自定义背景，仅保存在本机</view>
      <view class="ft-10 op-55" wx:else>长按 / 选择图片作为专注背景，可随时恢复</view>
    </view>

    <!-- ============ 专注页面 ============ -->
    <view class="glass card">
      <view class="serif ft-xl mb4">专注页面</view>

      <!-- 肯定语页面 -->
      <view class="ft-xs op-60 track-widest mb3">肯定语页面</view>

      <view class="ft-sm op-70 mb2">计时模式</view>
      <view class="seg-pair mb5">
        <view class="sseg {{affirmTimerMode === 'countdown' ? 'sel' : ''}}" data-field="affirmTimerMode" data-value="countdown" hover-class="pressed" bindtap="segTap">倒计时</view>
        <view class="sseg {{affirmTimerMode === 'stopwatch' ? 'sel' : ''}}" data-field="affirmTimerMode" data-value="stopwatch" hover-class="pressed" bindtap="segTap">正计时（秒表）</view>
      </view>

      <view class="sw-row">
        <text class="ft-sm">计数器音效提示</text>
        <switch checked="{{sound}}" color="#4a79b8" data-field="sound" bindchange="onSwitch" />
      </view>
      <view class="sw-row">
        <text class="ft-sm">启用自动计数功能</text>
        <switch checked="{{autoCountEnabled}}" color="#4a79b8" data-field="autoCountEnabled" bindchange="onSwitch" />
      </view>

      <view class="s-inset" wx:if="{{autoCountEnabled}}">
        <view class="row-between mb3">
          <text class="ft-sm">自动计数间隔</text>
          <view class="row gap2 items-center">
            <input
              class="s-num mono"
              type="digit"
              value="{{autoCountInterval}}"
              data-field="autoCountInterval"
              bindinput="onInt"
            />
            <text class="ft-sm op-70">秒 / 次</text>
          </view>
        </view>
        <slider
          min="0.1"
          max="10"
          step="0.1"
          value="{{autoCountInterval}}"
          activeColor="#4a79b8"
          block-size="20"
          data-field="autoCountInterval"
          bindchange="onSlider"
        />
        <view class="ft-10 op-55">开启计时后按固定间隔自动 +1，可与手动计数叠加</view>
      </view>

      <view class="sw-row">
        <text class="ft-sm">显示「重置计数」按钮</text>
        <switch checked="{{resetCounterEnabled}}" color="#4a79b8" data-field="resetCounterEnabled" bindchange="onSwitch" />
      </view>

      <view class="ft-sm op-70 mb2 mt5">计数器显示</view>
      <view class="seg-pair">
        <view class="sseg {{counterMode === 'today' ? 'sel' : ''}}" data-field="counterMode" data-value="today" hover-class="pressed" bindtap="segTap">今日计数</view>
        <view class="sseg {{counterMode === 'total' ? 'sel' : ''}}" data-field="counterMode" data-value="total" hover-class="pressed" bindtap="segTap">累计计数</view>
      </view>

      <!-- 呼吸调整页面 -->
      <view class="card-sep"></view>
      <view class="ft-xs op-60 track-widest mb3">呼吸调整页面</view>

      <view class="ft-sm op-70 mb2">计时模式</view>
      <view class="seg-pair mb5">
        <view class="sseg {{breathTimerMode === 'countdown' ? 'sel' : ''}}" data-field="breathTimerMode" data-value="countdown" hover-class="pressed" bindtap="segTap">倒计时</view>
        <view class="sseg {{breathTimerMode === 'stopwatch' ? 'sel' : ''}}" data-field="breathTimerMode" data-value="stopwatch" hover-class="pressed" bindtap="segTap">正计时（秒表）</view>
      </view>

      <view class="ft-sm op-70 mb2">呼吸节奏</view>
      <view class="row flex-wrap gap2 mb4">
        <view class="chip {{breathMode === 'box' ? 'sel' : ''}}" data-mode="box" hover-class="pressed" bindtap="breathModeTap">箱式 4-4-4-4</view>
        <view class="chip {{breathMode === '478' ? 'sel' : ''}}" data-mode="478" hover-class="pressed" bindtap="breathModeTap">4-7-8</view>
        <view class="chip {{breathMode === 'custom' ? 'sel' : ''}}" data-mode="custom" hover-class="pressed" bindtap="breathModeTap">自定义</view>
        <view class="chip {{breathMode === 'off' ? 'sel' : ''}}" data-mode="off" hover-class="pressed" bindtap="breathModeTap">关闭</view>
      </view>

      <block wx:if="{{breathMode === 'custom'}}">
        <view class="custom-grid">
          <view class="c-cell">
            <text class="ft-xs op-60 mb1">吸</text>
            <input class="c-inp mono" type="number" value="{{inhale}}" data-field="inhale" bindinput="customNum" />
          </view>
          <view class="c-cell">
            <text class="ft-xs op-60 mb1">屏</text>
            <input class="c-inp mono" type="number" value="{{hold1}}" data-field="hold1" bindinput="customNum" />
          </view>
          <view class="c-cell">
            <text class="ft-xs op-60 mb1">呼</text>
            <input class="c-inp mono" type="number" value="{{exhale}}" data-field="exhale" bindinput="customNum" />
          </view>
          <view class="c-cell">
            <text class="ft-xs op-60 mb1">屏</text>
            <input class="c-inp mono" type="number" value="{{hold2}}" data-field="hold2" bindinput="customNum" />
          </view>
        </view>
        <view class="ft-10 op-55 mt3">自定义节奏：吸 / 屏 / 呼 / 屏 的秒数</view>
      </block>
      <view class="ft-10 op-55 mt3" wx:else>关闭后将不显示呼吸引导，仅保留计时</view>
    </view>

    <!-- ============ 数据 ============ -->
    <view class="glass card">
      <view class="serif ft-xl mb4">数据</view>

      <view class="row gap2 mb3">
        <view class="act flex-1" hover-class="pressed" bindtap="doExport">导出到剪贴板</view>
        <view class="act flex-1" hover-class="pressed" bindtap="openImport">导入数据</view>
      </view>
      <view class="act danger flex-1" hover-class="pressed" bindtap="openReset">重置全部数据</view>

      <view class="ft-10 op-55 lh-relaxed mt4">
        所有数据仅保存在当前设备本地，从不上传、不分享。
        如需转移设备：先「导出」复制 JSON，再到新设备「导入」粘贴即可。
      </view>
    </view>
  </view>

  <view class="foot">
    <text>GG RESET 小程序版 · 所有功能免费。</text>
    <text>本工具仅供日常正念打卡与习惯记录使用，不提供任何专业建议。</text>
    <text>数据仅储存在本机，不收集、不上传、不分享任何信息。</text>
  </view>

  <!-- ============ 更新日志 ============ -->
  <view class="overlay" wx:if="{{logVisible}}" bindtap="closeLog">
    <view class="dialog" catchtap="noop">
      <view class="dialog-close" bindtap="closeLog">✕</view>
      <view class="serif ft-lg mb4">更新日志</view>
      <view class="s-log-sec">
        <view class="log-date">2027 / 7 / 6</view>
        <view class="ft-sm op-60 lh-relaxed">更新账号登录系统，支持微信一键快捷登录与本机 OpenID。</view>
      </view>
      <view class="s-log-sec">
        <view class="log-date">2026 / 7</view>
        <view class="ft-sm op-60 lh-relaxed">更新肯定语数值手动调整、修改标签、重置计数器计数等功能，优化呼吸球颜色对比，修复计数器音效与白噪音播放的 Bug。</view>
      </view>
      <view class="btn btn-primary btn-block mt5" hover-class="pressed" bindtap="closeLog">知道了</view>
    </view>
  </view>

  <!-- ============ 导入数据 ============ -->
  <view class="overlay" wx:if="{{importVisible}}" bindtap="closeImport">
    <view class="dialog" catchtap="noop">
      <view class="dialog-close" bindtap="closeImport">✕</view>
      <view class="serif ft-lg mb3">导入数据</view>
      <view class="ft-xs op-60 lh-relaxed mb4">
        先将另一台设备导出的 JSON 复制到剪贴板，再粘贴到下方输入框。
        导入将覆盖当前本地同名数据，请谨慎操作。
      </view>
      <textarea
        class="ta-box"
        value="{{importText}}"
        bindinput="onImportInput"
        placeholder="在此粘贴 JSON 数据…"
        placeholder-class="ph"
        maxlength="-1"
      />
      <view class="row gap2 mt4">
        <view class="btn btn-ghost flex-1" hover-class="pressed" bindtap="closeImport">取消</view>
        <view class="btn btn-primary flex-1" hover-class="pressed" bindtap="doImport">导入</view>
      </view>
    </view>
  </view>

  <!-- ============ 重置数据 ============ -->
  <view class="overlay" wx:if="{{resetVisible}}" bindtap="closeReset">
    <view class="dialog" catchtap="noop">
      <view class="dialog-close" bindtap="closeReset">✕</view>
      <view class="serif ft-lg mb3">重置全部数据？</view>
      <view class="ft-xs op-60 lh-relaxed mb4">
        此操作不可恢复。所有肯定语、目标、标签、专注记录与设置都会被清空。
        建议先「导出到剪贴板」完成备份。
      </view>
      <input
        class="s-reset-input mono mb3"
        value="{{resetText}}"
        bindinput="onResetInput"
        placeholder="输入 reset 确认重置"
        placeholder-class="ph"
      />
      <view class="ft-10 mb4 {{resetOk ? 'ok-text' : 'op-55'}}">
        {{resetOk ? '已确认，可执行重置' : '请输入 reset 以解锁重置按钮'}}
      </view>
      <view class="row gap2">
        <view class="btn btn-ghost flex-1" hover-class="pressed" bindtap="closeReset">取消</view>
        <view class="btn btn-danger flex-1 {{resetOk ? '' : 'btn-disabled'}}" hover-class="{{resetOk ? 'pressed' : 'none'}}" bindtap="doReset">确认重置</view>
      </view>
    </view>
  </view>
</view>
