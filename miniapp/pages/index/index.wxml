<view class="app {{dark ? 'theme-dark' : ''}}">
  <image class="app-bg" src="{{bg}}" mode="aspectFill" />
  <view class="bg-tint"></view>

  <!-- ============ 主页内容 ============ -->
  <view class="pg home">
    <view class="hero">
      <text class="ft-xs track-4 op-60 tagline">FOCUS · COUNTER · TIMER</text>
      <view class="serif ft-6xl title">GG RESET</view>

      <block wx:if="{{!logged}}">
        <view class="link" hover-class="pressed" bindtap="openLogin">微信一键快捷登录 / 进入应用</view>
      </block>
      <block wx:else>
        <view class="link lg-none" hover-class="pressed" bindtap="openAccount">
          <text class="op-70">已登录 · 微信用户</text>
          <text class="num dim"> · {{mask}}</text>
        </view>
      </block>

      <view wx:if="{{guideShortcut}}" class="link" hover-class="pressed" bindtap="openGuide">第一次来？点击查看使用指南</view>
    </view>

    <view class="tiles">
      <view
        wx:for="{{tiles}}"
        wx:key="key"
        class="glass glass-hover tile"
        hover-class="hovered"
        data-url="{{item.url}}"
        bindtap="go"
      >
        <text class="tile-ic op-80">{{item.glyph}}</text>
        <view>
          <text class="tile-sub">{{item.sub}}</text>
          <text class="serif ft-lg tile-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="foot">
    <text class="f-line">本工具仅供日常正念打卡与习惯记录使用，不提供任何专业建议。</text>
    <text class="f-line">所有数据仅存储于本机，我们不收集、不上传、不分享任何个人信息。</text>
  </view>

  <!-- ============ 使用指南 ============ -->
  <view class="overlay" wx:if="{{showGuide}}" bindtap="closeGuide">
    <view class="dialog" catchtap="noop">
      <view class="dialog-close" catchtap="closeGuide">✕</view>
      <view class="serif ft-2xl">GG RESET · 使用指南</view>
      <scroll-view scroll-y class="guide-body">
        <view wx:for="{{guide}}" wx:key="t" class="guide-sec">
          <view class="serif ft-lg guide-h">{{item.t}}</view>
          <view
            wx:for="{{item.lines}}"
            wx:for-item="line"
            wx:key="*this"
            class="ft-sm lh-relaxed guide-p"
          >{{line}}</view>
        </view>
      </scroll-view>
      <view class="btn btn-primary btn-block mt5" hover-class="pressed" bindtap="closeGuide">知道了</view>
    </view>
  </view>

  <!-- ============ 登录弹窗 ============ -->
  <view class="overlay" wx:if="{{showLogin}}" bindtap="closeLogin">
    <view class="dialog dlg-narrow" catchtap="noop">
      <view class="dialog-close dlg-close-float" catchtap="closeLogin">✕</view>
      <view class="serif ft-2xl center-x mb1">登录 GG RESET</view>
      <view class="ft-10 op-60 center-x mb5">微信小程序同款 · 一键快捷登录，无需手机号与验证码</view>

      <view class="glass card-inset px4 py3 mb5 row items-start gap2">
        <text class="shield">◉</text>
        <text class="ft-10 lh-relaxed op-70 flex-1">
          <block wx:if="{{existingId}}">已检测到本机账号 <text class="num">{{existingId}}</text>，点击下方按钮将一键恢复登录。</block>
          <block wx:else>首次使用将为本机自动创建唯一账号（OpenID），数据安全保存在本机。</block>
        </text>
      </view>

      <view class="btn btn-primary w-full login-btn" hover-class="pressed" bindtap="doLogin">
        <view class="wx-badge">微信</view>
        <text class="ft-sm">微信一键快捷登录<text class="dim ft-10"> / 进入应用</text></text>
        <text class="dim ml2">→</text>
      </view>

      <view class="ft-10 op-50 col mt4 center">
        <text>模拟微信小程序 wx.login 静默登录 · OpenID 由本机生成</text>
        <text>不收集、不上传、不分享任何个人信息</text>
      </view>
    </view>
  </view>

  <!-- ============ 账户弹窗 ============ -->
  <view class="overlay" wx:if="{{showAccount}}" bindtap="closeAccount">
    <view class="dialog dlg-narrow" catchtap="noop">
      <view class="dialog-close dlg-close-float" catchtap="closeAccount">✕</view>
      <view class="serif ft-xl center-x mb1">账户</view>
      <view class="ft-10 op-60 center-x mb5">已登录 · 微信用户<text class="num"> · {{mask}}</text></view>

      <view class="glass card-inset px4 py2 mb5 account-rows">
        <view class="row-between py2h"><text class="op-60">登录方式</text><text class="op-90">微信一键快捷登录（本机 OpenID）</text></view>
        <view class="row-between py2h"><text class="op-60">账号标识</text><text class="num op-90">{{mask}}</text></view>
        <view class="row-between py2h"><text class="op-60">数据同步</text><text class="op-90">保存在本机 · 云端接入预留</text></view>
      </view>

      <view class="btn btn-glass w-full py3" hover-class="pressed" bindtap="doSignOut">退出登录</view>
      <view class="ft-10 op-50 center-x mt4 lh-relaxed">
        退出登录不会清除本机数据与账号标识，下次点击微信快捷登录即可一键恢复。
      </view>
    </view>
  </view>
</view>
