/* focus —— 进入专注（对应 Web focus.tsx；数值均按 Tailwind 默认 16px 换算） */

.f-page {
  position: relative;
  z-index: 2;
  max-width: 672px;
  margin: 0 auto;
  padding: 8px 16px 48px; /* px-4 / md:px-6，手机 16px */
}

/* ============ 页头 ============ */
.f-head {
  margin-bottom: 24px;
  padding-top: 12px;
}
.f-back {
  font-size: 18px;
  line-height: 1;
}
.f-gear {
  font-size: 15px;
  line-height: 1;
}
.seg-pill {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px; /* p-[3px] ≈ p1 */
  border-radius: 999px;
  flex: none;
}
.seg-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 18px; /* ≈ py-2 px-4（缩小到手机适配） */
  border-radius: 999px;
  font-size: 12px;
  color: var(--ink-dim);
  transition: all 0.3s ease;
  white-space: nowrap;
}
.seg-ic {
  font-size: 12px;
  line-height: 1;
}
.seg-btn.seg-on {
  background: var(--card-bg-strong);
  border: 1px solid var(--card-border);
  box-shadow: var(--card-shadow);
  color: var(--ink);
  font-weight: 600;
}

/* ============ 卡片 ============ */
.f-card {
  position: relative;
  padding: 24px; /* p-6 */
  margin-bottom: 20px; /* gap-5 */
}

/* 小型标题行：11px 大写间距（Web text-[11px] tracking-widest opacity-50 mb-2） */
.cap {
  display: block;
  text-align: center;
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--ink);
  opacity: 0.5;
  margin-bottom: 8px;
}
.cap.c-left {
  text-align: left;
}

/* ============ 计时卡 ============ */
.big-clock {
  text-align: center;
  font-size: 52px; /* text-5xl≈48 放大到时钟观感 */
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: 0.05em; /* tracking-wider */
  color: var(--ink);
  margin-top: 4px;
}
.t-actions {
  gap: 8px;
  margin-top: 20px; /* mt-5 */
}
.btn-dim {
  opacity: 0.45;
  pointer-events: none;
}

/* ============ 时间拨盘（Wheel） ============ */
.wheel {
  display: flex;
  justify-content: center;
  gap: 8px; /* gap-1.5≈6 视觉增强 */
  margin: 4px auto 0;
}
.w-col {
  position: relative;
  width: 84px;
}
.w-scroll {
  height: 180px; /* 5 行 × 36px */
  position: relative;
  z-index: 1;
  overflow: hidden;
}
.w-sp {
  height: 72px; /* 36*2 顶部/底部留白，让选中行居中 */
}
.w-row {
  height: 36px;
  line-height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  opacity: 0.3;
  transition: opacity 0.15s ease;
  text-align: center;
}
.w-row-sel {
  opacity: 1;
}
.w-num {
  font-family: "DengXian", "等线", "Helvetica Neue", Arial, sans-serif;
  font-size: 16px;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.w-row-sel .w-num {
  font-size: 30px; /* text-3xl */
  font-weight: 500;
}
.w-unit {
  font-size: 10px;
  opacity: 0.6;
  color: var(--ink);
}
.w-row-sel .w-unit {
  font-size: 10px;
}
.w-bar {
  position: absolute;
  left: 2px;
  right: 2px;
  top: 50%;
  transform: translateY(-50%);
  height: 36px;
  background: var(--card-bg-strong);
  border: 1px solid var(--card-border);
  box-shadow: var(--card-shadow);
  border-radius: 24px; /* rounded-xl 24px */
  z-index: 0;
  pointer-events: none;
}

/* ============ 计数器圆环 ============ */
.counter-card {
  text-align: center;
}
.cc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.cc-top .cap {
  margin-bottom: 0;
}
.cc-reset {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  box-shadow: var(--card-shadow);
  color: var(--ink);
}
.cc-quote {
  font-size: 12px;
  color: var(--ink);
  opacity: 0.5;
  margin-bottom: 20px;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 0 8px;
}
.cnt-ring {
  width: 240px; /* size-60 */
  height: 240px;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-align: center;
}
.cnt-num {
  font-size: 64px;
  line-height: 1;
  max-width: 78%;
  overflow: hidden;
  white-space: nowrap;
  color: var(--ink);
}
.cnt-plus {
  font-size: 12px;
  color: var(--ink);
  opacity: 0.7;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
.auto-row {
  margin-top: 24px; /* mt-6 */
  padding: 0 4px;
}

/* ============ 主题 chips ============ */
.chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}
.chip {
  padding: 10px 18px; /* 与 Web 主题标签接近 */
  border-radius: 999px;
  font-size: 14px;
  color: var(--ink);
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  box-shadow: var(--card-shadow);
  transition: all 0.3s ease;
}
.chip-sel {
  border: 2px solid var(--sel-border);
  font-weight: 600;
  box-shadow: var(--sel-shadow);
}

/* ============ 具体肯定语列表 ============ */
.aff-list {
  margin-top: 4px;
}
.aff-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px; /* py-3.5 px-4 ≈ */
  border-radius: 24px; /* rounded-xl */
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  margin-bottom: 8px;
  transition: all 0.3s ease;
}
.aff-row-sel {
  border: 2px solid var(--sel-border);
  box-shadow: var(--sel-shadow);
}
.aff-text {
  flex: 1;
  font-size: 14px;
  color: var(--ink);
  line-height: 1.55;
}
.aff-check {
  color: var(--ink);
  font-size: 16px;
  width: 20px;
  text-align: center;
  flex-shrink: 0;
}
.quote {
  color: var(--ink);
  opacity: 0.92;
  text-align: center;
  font-weight: 400;
}

/* ============ 呼吸球 ============ */
.breath-holder {
  display: flex;
  justify-content: center;
  padding: 8px 0;
}
.breath-ball {
  width: 260px;
  height: 260px;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.98) 0%, rgba(235, 245, 255, 0.95) 60%, rgba(210, 225, 245, 0.9) 100%);
  box-shadow: 0 20px 60px rgba(60, 110, 170, 0.35), inset 0 0 40px rgba(255, 255, 255, 0.4);
}
.theme-dark .breath-ball {
  background: radial-gradient(circle at 35% 30%, rgba(60, 90, 150, 0.95) 0%, rgba(30, 55, 110, 0.92) 60%, rgba(20, 35, 80, 0.9) 100%);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55), inset 0 0 40px rgba(255, 255, 255, 0.08);
}
.phase-text {
  font-size: 26px;
  color: #0f172a;
  letter-spacing: 0.02em;
}
.theme-dark .phase-text {
  color: #f3f8fb;
}
.breath-label-sub {
  font-size: 12px;
  color: var(--ink);
  opacity: 0.6;
  margin-top: 16px;
}

/* ============ 身心放松指南 ============ */
.relax-title {
  margin-bottom: 4px;
}
.tip-list {
  display: flex;
  flex-direction: column;
}
.tip {
  padding: 20px; /* p-5 */
  border-radius: 24px;
  margin-bottom: 12px;
}
.tip-t {
  margin-bottom: 6px;
}

/* ============ 白噪音 chips ============ */
.noise-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}
.noise-chip {
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 12px;
  color: var(--ink);
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  box-shadow: var(--card-shadow);
  transition: all 0.3s ease;
}
.noise-on {
  border: 2px solid var(--sel-border);
  font-weight: 600;
  box-shadow: var(--sel-shadow);
}

/* ============ 底部提示 ============ */
.f-hint {
  text-align: center;
  font-size: 11px;
  color: var(--ink);
  opacity: 0.5;
  padding: 8px 24px 16px;
  line-height: 1.6;
}

/* ============ 庆祝 ============ */
.celebrate-pop {
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--card-bg-strong);
  border: 1px solid var(--card-border);
  box-shadow: var(--card-shadow);
  border-radius: 32px;
  padding: 32px 24px;
  min-width: 200px;
}
.celebrate-emoji {
  font-size: 56px;
  line-height: 1;
}
