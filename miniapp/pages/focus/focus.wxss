/* 专注页 */

.count-ring {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  margin: 20rpx auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--glass-strong);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-strong);
  position: relative;
  overflow: hidden;
}
.count-ring::after {
  content: '';
  position: absolute;
  inset: 14rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border);
  opacity: .8;
}
.count-num {
  font-size: 140rpx;
  font-weight: 200;
  line-height: 1;
}
.count-label {
  font-size: 20rpx;
  color: var(--mut);
  margin-top: 8rpx;
}

.breath-holder {
  width: 100%;
  height: 460rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.breath-ball {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
}

.dur-picker {
  height: 360rpx;
  margin-top: 20rpx;
  background: var(--glass);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
}
.dur-col {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--fg);
}
