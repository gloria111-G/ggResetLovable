<view class="app {{dark ? 'theme-dark' : ''}}">
  <image class="app-bg" src="{{bg}}" mode="aspectFill" />
  <view class="bg-tint"></view>

  <!-- 目标达成庆祝 toast（对应 Web 顶部 pill） -->
  <view wx:if="{{celebrating}}" class="celebrate-pill glass-strong">
    <text class="serif ft-lg">恭喜你完成目标 ✨</text>
  </view>

  <view class="pg shell-main">
    <view class="m-grid">
      <!-- ============ 我的肯定语（Web Affirmations 卡） ============ -->
      <view class="glass card">
        <view class="row gap2 mb1">
          <text class="ft-lg m-spark">✨</text>
          <view class="serif ft-2xl">我的肯定语</view>
        </view>
        <view class="ft-xs op-60 mb4">为每条肯定语贴上分类标签，专注页面会用得到。</view>

        <!-- 标签 chips + 内联新增 -->
        <view class="row flex-wrap gap2 mb4">
          <block wx:for="{{tagChips}}" wx:key="tag">
            <view class="chip-wrap">
              <view
                class="chip {{curTag === item.tag ? 'sel' : ''}}"
                data-tag="{{item.tag}}"
                hover-class="pressed"
                bindtap="tagTap"
              >#{{item.tag}}</view>
              <view
                wx:if="{{item.custom}}"
                class="chip-x"
                data-tag="{{item.tag}}"
                hover-class="pressed"
                bindtap="delTag"
              >✕</view>
            </view>
          </block>
          <view class="row gap1">
            <input
              class="tag-add"
              placeholder="新标签"
              placeholder-class="ph"
              value="{{newTagText}}"
              confirm-type="done"
              bindinput="onNewTag"
              bindconfirm="addTag"
            />
            <view class="chip-add" hover-class="pressed" bindtap="addTag">
              <text class="chip-add-plus">＋</text>
            </view>
          </view>
        </view>

        <!-- 添加肯定语 -->
        <view class="row gap2 mb5">
          <input
            class="aff-add flex-1"
            placeholder="例：我值得被深深爱着。"
            placeholder-class="ph"
            value="{{newAffText}}"
            confirm-type="done"
            bindinput="onAffInput"
            bindconfirm="affAdd"
          />
          <view class="add-btn" hover-class="pressed" bindtap="affAdd">
            <text class="ft-base">＋</text>
            <text class="ft-sm">添加</text>
          </view>
        </view>

        <!-- 肯定语列表（全量） -->
        <block wx:if="{{affs.length}}">
          <view class="m-list">
            <view class="mrow glass" wx:for="{{affs}}" wx:key="id">
              <view class="m-tag">#{{item.tag || '未分类'}}</view>
              <view class="flex-1 ft-sm m-text">{{item.text}}</view>
              <view class="num ft-xs op-70 m-count">×{{item.count}}</view>
              <view class="m-gear op-50" data-id="{{item.id}}" hover-class="pressed" bindtap="affOpenEdit">⚙</view>
            </view>
          </view>
        </block>
        <view wx:else class="ft-sm op-50 center-x py4">还没有肯定语。</view>
      </view>

      <!-- ============ 目标列表（Web Goals 卡） ============ -->
      <view class="glass card">
        <view class="serif ft-2xl mb1">目标列表</view>
        <view class="ft-xs op-60 mb4">按住目标右侧「≡」上下拖动，可自由调整顺序。</view>

        <!-- 添加目标 -->
        <view class="row gap2 mb5">
          <input
            class="aff-add flex-1"
            placeholder="写下一个你想实现的目标…"
            placeholder-class="ph"
            value="{{addInput}}"
            confirm-type="done"
            bindinput="onGoalInput"
            bindconfirm="goalAdd"
          />
          <view class="add-btn" hover-class="pressed" bindtap="goalAdd">
            <text class="ft-base">＋</text>
            <text class="ft-sm">添加</text>
          </view>
        </view>

        <!-- 进行中 -->
        <block wx:if="{{goalActive.length}}">
          <view class="m-list goal-list">
            <view class="ft-xs op-60 mb4">按住目标右侧「≡」上下拖动，即可自由调整顺序。</view>
            <view
              class="mrow glass goal-row {{dragId === item.id ? 'goal-drag-on' : ''}}"
              wx:for="{{goalActive}}"
              wx:key="id"
              style="transform: translateY({{item.dy || 0}}px);"
            >
              <view class="gcheck" data-id="{{item.id}}" hover-class="pressed" bindtap="goalToggle"></view>
              <view class="flex-1 ft-sm m-text">{{item.text}}</view>
              <view class="mini-ic danger-ic" data-id="{{item.id}}" hover-class="pressed" bindtap="goalDel">🗑</view>
              <view
                class="goal-drag-ic"
                data-id="{{item.id}}"
                data-index="{{index}}"
                catchtouchstart="goalDragStart"
                catchtouchmove="goalDragMove"
                catchtouchend="goalDragEnd"
                catchtouchcancel="goalDragEnd"
              >≡</view>
            </view>
          </view>
        </block>
        <view wx:else class="ft-sm op-50 center-x py4">写下第一个想实现的目标吧。</view>

        <!-- 已实现 -->
        <block wx:if="{{goalDone.length}}">
          <view class="serif ft-lg mt6 mb3">已实现：</view>
          <view class="m-list">
            <view class="mrow glass g-done" wx:for="{{goalDone}}" wx:key="id">
              <view class="gcheck done" data-id="{{item.id}}" hover-class="pressed" bindtap="goalToggle">
                <text class="gcheck-tick">✓</text>
              </view>
              <view class="flex-1 ft-sm strike m-text">{{item.text}}</view>
              <view class="mini-ic danger-ic" data-id="{{item.id}}" hover-class="pressed" bindtap="goalDel">🗑</view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view class="foot">
    <text>本工具仅供日常正念打卡与习惯记录使用，不提供任何专业建议。</text>
    <text>所有数据仅存储于本机，我们不收集、不上传、不分享任何个人信息。</text>
  </view>

  <!-- ============ 编辑肯定语弹窗（Web AffirmSettingsDialog） ============ -->
  <view class="overlay" wx:if="{{editVisible}}" bindtap="closeEdit">
    <view class="dialog dlg-sm" catchtap="noop">
      <view class="dialog-close" catchtap="closeEdit">✕</view>
      <view class="ft-10 op-60 mb1">#{{editAff.tag || '未分类'}}</view>
      <view class="serif ft-lg mb4 m-edtext">{{editAff.text}}</view>

      <view class="ft-xs op-70 mb2">所属标签（可切换，历史数据将迁移到新标签）</view>
      <view class="row flex-wrap gap1 mb5">
        <view
          wx:for="{{tagChips}}"
          wx:key="tag"
          class="chip {{editAff.tag === item.tag ? 'sel' : ''}}"
          data-tag="{{item.tag}}"
          hover-class="pressed"
          bindtap="editTagTap"
        >#{{item.tag}}</view>
      </view>

      <view class="ft-xs op-70 mb2">当前计数（可手动输入）</view>
      <view class="row gap2 mb5">
        <input
          class="aff-add flex-1 cnt-input"
          type="number"
          value="{{editCountText}}"
          bindinput="onEditCount"
        />
        <view class="save-btn" hover-class="pressed" bindtap="editSave">
          <text class="ft-sm">保存</text>
        </view>
      </view>

      <view class="del-btn" hover-class="pressed" bindtap="editDelete">
        <text class="ft-sm">🗑 删除肯定语</text>
      </view>
      <view class="ft-10 op-55 center-x mt3">保存后数值会即时同步到计数器和数据中心。</view>
    </view>
  </view>
</view>
