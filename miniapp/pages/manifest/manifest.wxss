/* 目标列表页 */
.goal-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  background: var(--glass-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--mut);
  flex: none;
}
.goal-check.done {
  background: #07c160;
  border-color: #07c160;
  color: #fff;
  font-size: 26rpx;
}
